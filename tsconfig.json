{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],

    "module": "commonjs",
    "moduleResolution": "node",

    "types": ["node"],

    "ignoreDeprecations": "6.0",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,

    "baseUrl": ".",

    "paths": {
      "@pages/*": ["pages/*"],
      "@data/*": ["data/*"],
      "@utils/*": ["utils/*"],
      "@fixtures/*": ["fixtures/*"]
    }
  },

  "include": [
    "tests/**/*.ts",
    "pages/**/*.ts",
    "fixtures/**/*.ts",
    "data/**/*.ts",
    "utils/**/*.ts",
    "playwright.config.ts"
  ],

  "exclude": [
    "node_modules",
    "playwright-report",
    "test-results"
  ]
}